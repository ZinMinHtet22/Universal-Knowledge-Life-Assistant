# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ukla_db

# Redis Caching
REDIS_URL=redis://localhost:6379/0

# AI Routing Models
LIGHTWEIGHT_MODEL=ollama/llama3:8b
# To use groq instead: LIGHTWEIGHT_MODEL=groq/llama3-8b-8192
# To use qwen instead: LIGHTWEIGHT_MODEL=ollama/qwen2.5:7b

ADVANCED_MODEL=openai/gpt-4o
# ADVANCED_MODEL=deepseek/deepseek-chat

# API Keys
# OPENAI_API_KEY=your_openai_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
